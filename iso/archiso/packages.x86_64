# Pitchstone OS - Minimal live ISO package list
# Goal: Boot to a usable Plasma desktop. Theme can be rough at first.

# Base system
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux
memtest86+

# Networking
networkmanager
wpa_supplicant
# dhclient removed — NetworkManager provides its own DHCP client

# Firmware / hardware
sof-firmware
intel-ucode
amd-ucode

# Plasma desktop (minimal but functional)
plasma-desktop
plasma-workspace
plasma-pa
plasma-nm
kinfocenter
kscreen
kwalletmanager
sddm
sddm-kcm
breeze
breeze-gtk

# Essential applications for live session
konsole
dolphin
firefox
nano
vim

# Shell (root is set to /usr/bin/zsh in passwd)
zsh

# Installer
# calamares is NOT in official Arch repos (AUR only).
# Removed so the first mkarchiso build can succeed.
# Add back later via local repo or Chaotic-AUR once core profile is stable.

# Utilities needed for live environment
sudo
xdg-user-dirs
xdg-utils
gparted
inetutils

# Filesystem tools
btrfs-progs
e2fsprogs
xfsprogs
