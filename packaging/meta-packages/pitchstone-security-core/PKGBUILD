  'sqlmap'
  # Wireless
  'aircrack-ng'
  # Forensics light
  'binwalk'
  'foremost'
  # Quality of life / supporting
  'git'
  'python'
  'tmux'
  'jq'
  'wireguard-tools'
  'openvpn'
)
