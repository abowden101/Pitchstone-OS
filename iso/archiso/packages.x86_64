# Pitchstone OS - Minimal live ISO package list
# Goal: Boot to a usable Plasma desktop. Theme can be rough at first.

# Base system
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux
memtest86+

# Networking
networkmanager
wpa_supplicant
dhclient

# Firmware / hardware
sof-firmware
intel-ucode
amd-ucode

# Plasma desktop (minimal but functional)
plasma-desktop
plasma-workspace
plasma-pa
plasma-nm
kinfocenter
kscreen
kwalletmanager
sddm
sddm-kcm
breeze
breeze-gtk

# Essential applications for live session
konsole
dolphin
firefox
nano
vim

# Installer
# calamares is NOT in official Arch repos (AUR only).
# Removed so the first mkarchiso build can succeed.
# Add back later via AUR or a custom package once the ISO boots.

# Utilities needed for live environment
sudo
xdg-user-dirs
xdg-utils
gparted

# Filesystem tools
btrfs-progs
e2fsprogs
xfsprogs
